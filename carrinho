#include <GL/glut.h>
#include <GL/freeglut.h>

float x = 0;
float y = 0;



void display (){

    glClear(GL_COLOR_BUFFER_BIT);

    glPushMatrix();
    glTranslatef(x,y,0);

    glColor3f(0,1,1);//cor do carrinho

    glBegin(GL_QUADS); //vertices do carrinho
        glVertex2f(0,0.05);// 1 plano +x+y
        glVertex2f(-0.05,0.05);// 2 plano -x+y
        glVertex2f(-0.05,-0.05);// 3 plano -x-y
        glVertex2f(0,-0.05);// 4 plano +x-y
    glEnd();

    glPopMatrix();

    glFlush();
}
void keyboard(unsigned char key, int xmouse, int ymouse){ //faz ele andar nas direções do teclado

    if(key == 'a')
        x -= 0.05;

    if(key == 'd')
        x += 0.05;
    
    if(key == 'w')
        y += 0.05;

    if(key == 's')
        y -= 0.05;

    glutPostRedisplay();
}


int main(int argc, char** argv) {
    glutInit(&argc, argv);//criação da janela
    glutInitWindowSize(800,600);
    glutCreateWindow("jogador");
    glutDisplayFunc(display);
    glutKeyboardFunc(keyboard);// captura os botões apertados

    glutMainLoop();
}
