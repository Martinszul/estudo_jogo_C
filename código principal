// === Renderiza o mapa ===
void mapaRodar(){
    for(int l = 0; l < 25; l++){
        for(int c = 0; c  < 25; c++){
            if(mapa[l][c] != 10){
                if(mapa[l][c] == 0) glColor3ub(128, 128, 128); if(mapa[l][c] == 1) glColor3ub(255, 255, 255); if(mapa[l][c] == 3) glColor3ub(255, 0, 0);

                float x = -0.7 + c * tamanhoX; 
                float y = -1.0 + l * tamanhoY;

                glBegin(GL_QUADS);
                    glVertex2f(x, y);
                    glVertex2f(x + tamanhoX, y);
                    glVertex2f(x + tamanhoX, y + tamanhoY);
                    glVertex2f(x, y + tamanhoY);
                glEnd();
            }
        }
    }
}


// === Registra quais teclas estão pressionadas ===
void teclaMovendo(unsigned char key, int a, int b){
    if(key == 'a') moveEsq = 1;
    if(key == 'd') moveDir = 1;
    if(key == 'w') moveCima = 1;
    if(key == 's') moveBaixo = 1;
    if(key == 'r' && vida <= 0){
        vida = 3;
        posYcram = 1.0;
        posXcram = -1.5;
        POSxjg = 0.0;
        POSyjg = 0.0;
        posxcrve = 1.5;
        tamanhoX =  0.056;
    }
}

// === Detecta quando uma tecla foi solta e desativa o movimento correspondente ===
void teclaSolta(unsigned char key, int a, int b){
    if(key == 'a') moveEsq = 0;
    if(key == 'd') moveDir = 0;
    if(key == 'w') moveCima = 0;
    if(key == 's') moveBaixo = 0;
}

// === Movimento do jogador e Limite do mapa ===
void moverJogador(int valor){
    float velocidadeCaminhar = 0.0050;
    if(moveEsq) POSxjg -= velocidadeCaminhar;
    if(moveDir) POSxjg += velocidadeCaminhar; 
    if(moveCima) POSyjg += velocidadeCaminhar;
    if(moveBaixo) POSyjg -= velocidadeCaminhar;

    if(POSxjg > limiteX) POSxjg = limiteX;
    if(POSxjg < -limiteX) POSxjg = -limiteX;
    if(POSyjg < -limiteY) POSyjg = -limiteY;
    if(POSyjg > limiteY) POSyjg = limiteY;
    if(vida == 0){
        tamanhoX = 0;
        POSxjg = 5.0;
        posXcram = -5.0;
        posxcrve = -5.0;
    }
    glutTimerFunc(5, moverJogador, 0);
    glutPostRedisplay();
}

// === Detecção de colisão ===
void colisao(){
    float dx = POSxjg - posXcram;
    float dy = POSyjg - posYcram;
    float dxx = POSxjg - posxcrve;
    float dyy = POSyjg - posycrve;

    if(dx < 0.09 && dx > -0.09 && dy < 0.18 && dy > -0.18){
        if(emColisao == 0){
            vida = vida - 1;
            emColisao = 1;
            posYcram = 2.2;
        } else {
        emColisao = 0;
    }
    }

    
    if(dxx < 0.09 && dxx > -0.09 && dyy < 0.18 && dyy > -0.18){
        if(emColisao == 0){
            vida = vida - 1;
            emColisao = 1;
            posycrve = 2.2;
        }
    } else {
        emColisao = 0;
    }
}


// === Placar de vida ===
void placarVida(){
    glColor3ub(255, 255, 255);
    if(vida == 0){
        glRasterPos2f(5.0, 5.0);
    }
    else{
        glRasterPos2f(-0.93, 0.8);
        sprintf(texto, "Vidas: %d", vida);
        for(int i = 0; texto[i] != '\0'; i++){
            glutBitmapCharacter(GLUT_BITMAP_HELVETICA_18, texto[i]);
        }
    }
}

// === Tela fim de jogo ===
void gameOver(){
    if(vida == 0){
        glColor3ub(0, 0, 0);
        glRasterPos2f(-0.15, 0.0);
        sprintf(texto, "FIM DE JOGO !");
        for(int i = 0; texto[i] != '\0'; i++){
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_18, texto[i]);
        }
    }
}

// === Função principal de desenho — chamada a cada frame ===
void display(){
    glClear(GL_COLOR_BUFFER_BIT);
    mapaRodar();
    glPushMatrix();
    glTranslated(POSxjg, POSyjg,0);
    carrinhoRodar();
    glPopMatrix();
    glPushMatrix();
    glTranslatef(posXcram,posYcram,0);
    obstaculo1Rodar();
    glPopMatrix();
    glPushMatrix();
    glTranslatef(posxcrve,posycrve,0);
    obstaculo2Rodar();
    glPopMatrix();
    glPushMatrix();
    glTranslatef(posxcrzu,posycrzu,0);
    obstaculo3Rodar();
    glPopMatrix();
    glPushMatrix();
    glTranslatef(posxcros,posycros,0);
    obstaculo4Rodar();
    glPopMatrix();
    placarVida();
    colisao();
    gameOver();
    glFlush();
}

// === Inicialização do jogo ===
int main(int argc, char** argv){
    glutInit(&argc, argv);
    srand(time(NULL));
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(800,600);
    glutCreateWindow("Jogo Dois");
    glClearColor(0.2, 0.2, 0.2, 1.0);
    glutKeyboardFunc(teclaMovendo);
    glutKeyboardUpFunc(teclaSolta);
    glutTimerFunc(16, moverJogador, 0);
    glutTimerFunc(16,update4,0);
    glutTimerFunc(16,update3,0);
    glutTimerFunc(16,update2,0);
    glutTimerFunc(16,update,0);
    glutDisplayFunc(display);
    glutMainLoop();
}
