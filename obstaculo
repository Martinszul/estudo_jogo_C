#include <GL/freeglut.h>

void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    glColor3f(1,1,0);

    glBegin(GL_QUADS);// obstaculo 1 esquerdo
        glVertex2f(-0.3,0.5);//vertice CIMA ESQ
        glVertex2f(-0.7,0.5);//vertive CIMA DIR
        glVertex2f(-0.7,-0.5);//vertice BAIX ESQ
        glVertex2f(-0.3,-0.5);//vertice BAIX DIR
    glEnd();

    glFlush();



    glColor3f(1,0,0);// obstaculo 2 direito

    glBegin(GL_QUADS);
        glVertex2f(0.3,0.5);
        glVertex2f(0.7,0.5);
        glVertex2f(0.7,-0.5);
        glVertex2f(0.3,-0.5);
    glEnd();

    glFlush();
   

    glColor3f(1,1,1);// obstaculo 3 meio

    glBegin(GL_QUADS);
        glVertex2f(0.2,0.5);
        glVertex2f(-0.2,0.5);
        glVertex2f(-0.2,-0.5);
        glVertex2f(0.2,-0.5);
    glEnd();

    glFlush();
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutCreateWindow("Obstaculo");

    glutDisplayFunc(display);
    glutMainLoop();
}
